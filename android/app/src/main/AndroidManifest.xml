<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Météo des fonds dynamiques : position approximative, demandée seulement si l'option est utilisée. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- « Selon le lieu » : position précise, puis « Toujours autoriser » pour la lire app fermée ; demandées seulement si l'option est utilisée. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- « HD seulement en Wi-Fi » : savoir si la connexion est limitée (données mobiles). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Mises à jour intégrées : ouvrir l'installateur avec l'APK de la dernière release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notification « Fond du jour » (facultative, demandée quand l'option est activée). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Enregistrer dans la galerie sur Android 9 et moins (inutile ensuite). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".PrismeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|assetsPaths"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Raccourcis de l'icône : action lancée sans ouvrir l'interface. Exportée : certains
             lanceurs démarrent la cible d'un raccourci comme une appli tierce. -->
        <activity
            android:name=".quick.QuickActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Tuile des Réglages rapides « Fond suivant ». -->
        <service
            android:name=".quick.NextWallpaperTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_next"
            android:label="@string/tile_next"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget d'écran d'accueil : aperçu du fond actuel et bouton « Fond suivant ». Exporté : le système lui envoie
             APPWIDGET_UPDATE. L'action du bouton n'est pas dans le filtre : il envoie une diffusion explicite. Si une autre
             appli en fait autant, l'effet est seulement un changement de fond, comme avec les raccourcis de l'icône (exportés aussi). -->
        <receiver
            android:name=".widget.PrismeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prisme_widget_info" />
        </receiver>

        <!-- Pochette de la musique : écoute les sessions média des applis de musique (accès aux notifications
             accordé dans les réglages Android ; aucune notification n'est lue). Inactif tant que l'option est coupée. -->
        <service
            android:name=".music.MusicListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fond animé avec parallaxe (option désactivée par défaut dans l'app). -->
        <service
            android:name=".live.ParallaxWallpaperService"
            android:exported="true"
            android:label="@string/live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/parallax_wallpaper" />
        </service>

        <!-- Fond vidéo (option désactivée par défaut dans l'app) : service à part, car une surface qui a servi au
             canevas (fond animé ci-dessus) ne peut plus recevoir de vidéo, et inversement. -->
        <service
            android:name=".live.VideoWallpaperService"
            android:exported="true"
            android:label="@string/video_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Relief 3D : ML Kit n'est initialisé qu'à la première préparation d'un relief, pas à chaque
             démarrage de l'app ou du fond animé. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>

</manifest>
