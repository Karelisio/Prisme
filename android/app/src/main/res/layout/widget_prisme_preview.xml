<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du widget dans la liste des widgets (Android 12+) : un faux fond d'écran et le vrai bouton,
     aux couleurs Material You de l'utilisateur. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_preview_art" />

    <include layout="@layout/widget_next_button" />
</FrameLayout>
